<Window x:Class="IsaacRepentancePlusAchievements.UnlockToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achievement Unlocked"
        Width="386" Height="106"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0">

    <Grid Margin="6">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" X="36" Y="0"/>
        </Grid.RenderTransform>

        <!-- Outer Toast Frame -->
        <Border x:Name="ToastBorder"
                Background="#131722"
                BorderBrush="#E5B85C"
                BorderThickness="1.5"
                CornerRadius="8"
                Cursor="Hand"
                MouseLeftButtonUp="ToastBorder_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Opacity="0.65"/>
            </Border.Effect>

            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="3"/>
                </Grid.RowDefinitions>

                <!-- Left Gold-Emerald Accent Strip -->
                <Border Grid.Row="0"
                        Width="4"
                        HorizontalAlignment="Left"
                        CornerRadius="6,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#E5B85C" Offset="0.0"/>
                            <GradientStop Color="#4ADE80" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Main Toast Content -->
                <Grid Grid.Row="0" Margin="14,10,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Achievement Pixel-Art Icon -->
                    <Border Grid.Column="0"
                            Width="58" Height="58"
                            Background="#0B0D12"
                            BorderBrush="#E5B85C"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="ImgToastIcon"
                                   Stretch="UniformToFill"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <Border Background="#D9153828"
                                    BorderBrush="#4ADE80"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="3,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="2">
                                <TextBlock Text="✓" Foreground="#6EE7B7" FontSize="9.5" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Achievement Text Details -->
                    <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock x:Name="TxtToastHeader"
                                       Text="🏆 SECRET UNLOCKED!"
                                       Foreground="#E5B85C"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border Background="#1E4633"
                                    BorderBrush="#34D399"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="5,0"
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="TxtToastId"
                                           Text="#001"
                                           Foreground="#6EE7B7"
                                           FontFamily="Consolas, Segoe UI"
                                           FontSize="10"
                                           FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock x:Name="TxtToastTitle"
                                   Text="Magdalene"
                                   Foreground="#F2F4F8"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,2"/>

                        <TextBlock x:Name="TxtToastDesc"
                                   Text="Unlocked a new character."
                                   Foreground="#9BA3B8"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Dismiss Button -->
                    <Button Grid.Column="2"
                            Width="22" Height="22"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#7D8599"
                            Cursor="Hand"
                            Click="BtnDismiss_Click"
                            ToolTip="Close">
                        <TextBlock Text="✕" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- Bottom Auto-Hide Countdown Bar -->
                <Grid Grid.Row="1" Background="#0D1017">
                    <Border x:Name="CountdownFillBar"
                            HorizontalAlignment="Left"
                            Width="370"
                            Background="#E5B85C"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="IsaacRepentancePlusAchievements.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Binding of Isaac: Repentance+ - Achievement Viewer"
        Width="1380" Height="860"
        MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Title Bar Control Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#241915"/>
            <Setter Property="Foreground" Value="#EAD8BF"/>
            <Setter Property="BorderBrush" Value="#4D362B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D2A22"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C49746"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A110E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style (Blood Red Hover) -->
        <Style x:Key="CloseBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Background" Value="#4A1717"/>
            <Setter Property="BorderBrush" Value="#7D2828"/>
            <Setter Property="Foreground" Value="#F5E6D3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9E1F1F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E34B4B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#631212"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Tab Button Style -->
        <Style x:Key="IsaacFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#251B16"/>
            <Setter Property="Foreground" Value="#DECBB0"/>
            <Setter Property="BorderBrush" Value="#4E382C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3B2A21"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#C49746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save Slot Button Style -->
        <Style x:Key="SaveSlotButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="slotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="11,7">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="slotBorder" Property="BorderBrush" Value="#E0B25B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Basement Frame -->
    <Border x:Name="OuterWindowBorder"
            Background="#140F0D"
            BorderBrush="#593A2B"
            BorderThickness="2"
            CornerRadius="6">
        <Border BorderBrush="#261813" BorderThickness="2" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Custom Isaac Title Bar -->
                    <RowDefinition Height="44"/>
                    <!-- Row 1: Compact Save Slots & Progress Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Clean 6-Trophy Milestones Strip -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Search & Filter Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 4: Achievements List + Secret Found Parchment Panel -->
                    <RowDefinition Height="*"/>
                    <!-- Row 5: Footer Status Bar -->
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ==================== ROW 0: CUSTOM TITLE BAR ==================== -->
                <Border Grid.Row="0"
                        Background="#0E0A08"
                        BorderBrush="#4A251D"
                        BorderThickness="0,0,0,1.5"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="14,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Isaac Emblem & App Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" Background="#2B1612" BorderBrush="#8C2D22" BorderThickness="1.5" CornerRadius="14" Margin="0,0,10,0">
                                <Canvas Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Fill="#E3C7A6" Stroke="#382218" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="6.5" Canvas.Top="11" Width="2.5" Height="7" Fill="#4EA8DE"/>
                                    <Rectangle Canvas.Left="15" Canvas.Top="11" Width="2.5" Height="7" Fill="#4EA8DE"/>
                                    <Ellipse Canvas.Left="6" Canvas.Top="8.5" Width="3.5" Height="3.5" Fill="#1E120E"/>
                                    <Ellipse Canvas.Left="14.5" Canvas.Top="8.5" Width="3.5" Height="3.5" Fill="#1E120E"/>
                                    <Path Data="M 8.5,16.5 Q 12,14 15.5,16.5" Stroke="#382218" StrokeThickness="1.5"/>
                                </Canvas>
                            </Border>

                            <TextBlock Text="THE BINDING OF ISAAC: REPENTANCE+"
                                       Foreground="#F2E2C9"
                                       FontSize="13.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border Background="#7A1C1C" BorderBrush="#B83737" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTitleBadge" Text="ACHIEVEMENT VIEWER" Foreground="#FFF0DB" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <Border Background="#172416" BorderBrush="#3E6B3A" BorderThickness="1" CornerRadius="3" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtReadOnlyShield" Text="🔒 Read-Only" Foreground="#B4E8AE" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="TxtTitleSubtitle" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- Right: Language Flag Emoji Switcher + Action Buttons + Window Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- TOP-RIGHT LANGUAGE SWITCHER BUTTON WITH FLAG EMOJI -->
                            <Button x:Name="BtnLanguageToggle"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="BtnLanguageToggle_Click"
                                    Margin="0,0,6,0"
                                    Height="28"
                                    ToolTip="Switch Language / Dili Değiştir (English ↔ Türkçe)">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="20" Height="14" CornerRadius="2" BorderBrush="#6E523F" BorderThickness="1" Margin="0,0,6,0" ClipToBounds="True">
                                        <Grid>
                                            <Canvas x:Name="FlagUkCanvas" Width="20" Height="14" Background="#012169" Visibility="Visible">
                                                <Line X1="0" Y1="0" X2="20" Y2="14" Stroke="#FFFFFF" StrokeThickness="2.6"/>
                                                <Line X1="20" Y1="0" X2="0" Y2="14" Stroke="#FFFFFF" StrokeThickness="2.6"/>
                                                <Line X1="0" Y1="0" X2="20" Y2="14" Stroke="#C8102E" StrokeThickness="1.2"/>
                                                <Line X1="20" Y1="0" X2="0" Y2="14" Stroke="#C8102E" StrokeThickness="1.2"/>
                                                <Rectangle Canvas.Left="8" Canvas.Top="0" Width="4" Height="14" Fill="#FFFFFF"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="5" Width="20" Height="4" Fill="#FFFFFF"/>
                                                <Rectangle Canvas.Left="8.8" Canvas.Top="0" Width="2.4" Height="14" Fill="#C8102E"/>
                                                <Rectangle Canvas.Left="0" Canvas.Top="5.8" Width="20" Height="2.4" Fill="#C8102E"/>
                                            </Canvas>

                                            <Canvas x:Name="FlagTrCanvas" Width="20" Height="14" Background="#E30A17" Visibility="Collapsed">
                                                <Ellipse Canvas.Left="4.2" Canvas.Top="3" Width="8" Height="8" Fill="#FFFFFF"/>
                                                <Ellipse Canvas.Left="5.8" Canvas.Top="3.8" Width="6.4" Height="6.4" Fill="#E30A17"/>
                                                <Polygon Points="12.2,7 13.8,5.8 13.2,7.6 14.7,6.5 12.8,6.5" Fill="#FFFFFF"/>
                                                <Ellipse Canvas.Left="12.5" Canvas.Top="5.8" Width="2.4" Height="2.4" Fill="#FFFFFF"/>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="TxtLanguageCode"
                                               Text="EN"
                                               Foreground="#FFF0D6"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="BtnRefreshSave"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="BtnRefreshSave_Click"
                                    Margin="0,0,6,0"
                                    Height="28"
                                    ToolTip="Reload save file (Read-Only)">
                                <TextBlock x:Name="TxtBtnRefresh" Text="↻ Refresh" FontSize="11.5"/>
                            </Button>

                            <Button x:Name="BtnSelectSaveFile"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="BtnSelectSaveFile_Click"
                                    Margin="0,0,12,0"
                                    Height="28"
                                    ToolTip="Open another .dat save file (Read-Only)">
                                <TextBlock x:Name="TxtBtnSelectSave" Text="📂 Open Save" FontSize="11.5"/>
                            </Button>

                            <Button x:Name="BtnMinimize"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Width="34" Height="28"
                                    Margin="0,0,4,0"
                                    Click="BtnMinimize_Click"
                                    ToolTip="Minimize">
                                <TextBlock Text="—" FontWeight="Bold"/>
                            </Button>

                            <Button x:Name="BtnMaximize"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Width="34" Height="28"
                                    Margin="0,0,4,0"
                                    Click="BtnMaximize_Click"
                                    ToolTip="Maximize / Restore">
                                <TextBlock x:Name="TxtMaximizeIcon" Text="▢" FontWeight="Bold"/>
                            </Button>

                            <Button x:Name="BtnClose"
                                    Style="{StaticResource CloseBarButtonStyle}"
                                    Width="38" Height="28"
                                    Click="BtnClose_Click"
                                    ToolTip="Close Application">
                                <TextBlock Text="✕" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== ROW 1: COMPACT SAVE SLOTS & PROGRESS BAR ==================== -->
                <Border Grid.Row="1"
                        Background="#1A1310"
                        BorderBrush="#3D2B22"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 3 Save File Slots -->
                            <ColumnDefinition Width="420"/>
                            <!-- Overall Progress Bar -->
                            <ColumnDefinition Width="*"/>
                            <!-- Compact Stats Strip -->
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Compact Save File 1 / 2 / 3 Selector Tabs -->
                        <UniformGrid Grid.Column="0" Columns="3" Margin="0,0,14,0">
                            <!-- SLOT 1 -->
                            <Button x:Name="BtnSlot1" Style="{StaticResource SaveSlotButtonStyle}" Margin="0,0,5,0" Click="BtnSlot1_Click" Background="#2E211B" BorderBrush="#C49746">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="TxtSlot1Header" Text="SAVE 1" Foreground="#F2DFC4" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtSlot1Percent" Text="0%" Foreground="#F0C265" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtSlot1Count" Text="0 / 641" Foreground="#C9B293" FontSize="11.5" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtSlot1Rank" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>

                            <!-- SLOT 2 -->
                            <Button x:Name="BtnSlot2" Style="{StaticResource SaveSlotButtonStyle}" Margin="2.5,0,2.5,0" Click="BtnSlot2_Click" Background="#1E1612" BorderBrush="#4A3429">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="TxtSlot2Header" Text="SAVE 2" Foreground="#F2DFC4" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtSlot2Percent" Text="0%" Foreground="#F0C265" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtSlot2Count" Text="0 / 641" Foreground="#C9B293" FontSize="11.5" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtSlot2Rank" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>

                            <!-- SLOT 3 -->
                            <Button x:Name="BtnSlot3" Style="{StaticResource SaveSlotButtonStyle}" Margin="5,0,0,0" Click="BtnSlot3_Click" Background="#1E1612" BorderBrush="#4A3429">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock x:Name="TxtSlot3Header" Text="SAVE 3" Foreground="#F2DFC4" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock x:Name="TxtSlot3Percent" Text="0%" Foreground="#F0C265" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                    </DockPanel>
                                    <TextBlock x:Name="TxtSlot3Count" Text="0 / 641" Foreground="#C9B293" FontSize="11.5" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtSlot3Rank" Visibility="Collapsed"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Center: Progress Bar -->
                        <Border Grid.Column="1"
                                Background="#231915"
                                BorderBrush="#473227"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,7"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock x:Name="TxtActiveSlotHeader"
                                               Text="ACTIVE SAVE: FILE 1"
                                               Foreground="#F2E0C4"
                                               FontWeight="Bold"
                                               FontSize="11.5"/>
                                    <TextBlock x:Name="TxtProgressSummary"
                                               Text="232 Unlocked / 409 Locked (36.2%)"
                                               Foreground="#F0C265"
                                               FontWeight="Bold"
                                               FontSize="11.5"
                                               HorizontalAlignment="Right"/>
                                </DockPanel>

                                <Grid Height="12">
                                    <Border Background="#120C0A" BorderBrush="#4F372B" BorderThickness="1" CornerRadius="3"/>
                                    <Border x:Name="ProgressFillBorder"
                                            HorizontalAlignment="Left"
                                            Width="120"
                                            Margin="1"
                                            CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7D1919" Offset="0.0"/>
                                                <GradientStop Color="#B83228" Offset="0.6"/>
                                                <GradientStop Color="#D99B38" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <TextBlock x:Name="TxtSaveFilePath" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Clean Inline Save Counters -->
                        <Border Grid.Column="2"
                                Background="#231915"
                                BorderBrush="#473227"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,6"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblStatMomKills" Text="MOM KILLS" Foreground="#9C8268" FontSize="9.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatMomKills" Text="0" Foreground="#F5E4CA" FontFamily="Consolas, Segoe UI" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblStatDeaths" Text="DEATHS" Foreground="#9C8268" FontSize="9.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatDeaths" Text="0" Foreground="#EB7A7A" FontFamily="Consolas, Segoe UI" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LblStatStreak" Text="STREAK" Foreground="#9C8268" FontSize="9.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatStreak" Text="0" Foreground="#92DE87" FontFamily="Consolas, Segoe UI" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="LblStatEden" Text="EDEN TOKENS" Foreground="#9C8268" FontSize="9.5" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatEden" Text="0" Foreground="#C4A6F0" FontFamily="Consolas, Segoe UI" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock x:Name="LblStatDonation" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtStatDonation" Visibility="Collapsed"/>
                                <TextBlock x:Name="LblStatItemsChallenges" Visibility="Collapsed"/>
                                <TextBlock x:Name="TxtStatItemsChallenges" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== ROW 2: CLEAN 6-TROPHY MILESTONES STRIP ==================== -->
                <Border Grid.Row="2"
                        Background="#16100D"
                        BorderBrush="#3D2B22"
                        BorderThickness="0,0,0,1"
                        Padding="14,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Label -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock x:Name="LblMilestonesTitle"
                                       Text="🏆 MILESTONES"
                                       Foreground="#E8B858"
                                       FontSize="11.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border Background="#2E2018" BorderBrush="#6E4E36" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtMilestonesProgress"
                                           Text="0 / 6"
                                           Foreground="#F5E3C6"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock x:Name="LblMilestonesHint" Visibility="Collapsed"/>
                        </StackPanel>

                        <!-- 6 Major Completion Milestones Cards in a Single Clean Row -->
                        <ItemsControl x:Name="IcMilestones" Grid.Column="1">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="MilestoneCard_Click"
                                            Tag="{Binding}"
                                            Margin="3,0"
                                            Cursor="Hand"
                                            ToolTip="{Binding DisplayUnlockBy}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="msBorder"
                                                        Background="{Binding CardBackgroundBrush}"
                                                        BorderBrush="{Binding CardBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="7,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 28x28 Milestone Icon + Lock Overlay -->
                                                        <Border Grid.Column="0"
                                                                Width="28" Height="28"
                                                                Background="#0D0908"
                                                                BorderBrush="#543C2E"
                                                                BorderThickness="1"
                                                                CornerRadius="3"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <Grid>
                                                                <Image Source="{Binding IconSource}"
                                                                       Stretch="UniformToFill"
                                                                       Opacity="{Binding ImageOpacity}"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                                                <Grid Visibility="{Binding LockOverlayVisibility}" Background="#55000000">
                                                                    <Border Width="16" Height="16"
                                                                            Background="#D91A110E"
                                                                            BorderBrush="#D49B4B"
                                                                            BorderThickness="1"
                                                                            CornerRadius="8"
                                                                            HorizontalAlignment="Center"
                                                                            VerticalAlignment="Center">
                                                                        <Canvas Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Path Data="M 3,4.5 L 3,3 C 3,1.5 7,1.5 7,3 L 7,4.5"
                                                                                  Stroke="#F0C775"
                                                                                  StrokeThickness="1.3"
                                                                                  Fill="Transparent"/>
                                                                            <Rectangle Canvas.Left="2" Canvas.Top="4.2"
                                                                                       Width="6" Height="4.5"
                                                                                       RadiusX="1" RadiusY="1"
                                                                                       Fill="#D99B3C"/>
                                                                        </Canvas>
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Milestone Title & Status -->
                                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ShortMilestoneTitle}"
                                                                       Foreground="#F5E6CE"
                                                                       FontWeight="Bold"
                                                                       FontSize="11"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding MilestoneStatusText}"
                                                                       Foreground="{Binding MilestoneStatusForeground}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="9.5"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="msBorder" Property="BorderBrush" Value="#F0C05A"/>
                                                        <Setter TargetName="msBorder" Property="Background" Value="#382820"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <!-- ==================== ROW 3: SEARCH & FILTER CONTROL BAR ==================== -->
                <Border Grid.Row="3"
                        Background="#1E1612"
                        BorderBrush="#3D2B22"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Search Box -->
                            <ColumnDefinition Width="235"/>
                            <!-- Unlock Status Filter Buttons -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- DLC Filter ComboBox -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Category Filter ComboBox -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Filtered Results Count -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Column="0"
                                Background="#120D0B"
                                BorderBrush="#543B2E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,12,0"
                                Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="#9C826B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtSearchPlaceholder"
                                           Grid.Column="1"
                                           Text="Search achievement or #ID..."
                                           Foreground="#786250"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="TxtSearch"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         Foreground="#F5E5CC"
                                         CaretBrush="#E5B95C"
                                         BorderThickness="0"
                                         FontSize="12.5"
                                         VerticalAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Status Filter Buttons (All / Unlocked / Locked / Milestones) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0">
                            <Button x:Name="BtnFilterAll"
                                    Content="All (641)"
                                    Style="{StaticResource IsaacFilterButtonStyle}"
                                    Click="BtnFilterAll_Click"/>
                            <Button x:Name="BtnFilterUnlocked"
                                    Content="✓ Unlocked (0)"
                                    Style="{StaticResource IsaacFilterButtonStyle}"
                                    Click="BtnFilterUnlocked_Click"/>
                            <Button x:Name="BtnFilterLocked"
                                    Content="🔒 Locked (0)"
                                    Style="{StaticResource IsaacFilterButtonStyle}"
                                    Click="BtnFilterLocked_Click"/>
                            <Button x:Name="BtnFilterMilestones"
                                    Content="🏆 Milestones (11)"
                                    Style="{StaticResource IsaacFilterButtonStyle}"
                                    Click="BtnFilterMilestones_Click"/>
                        </StackPanel>

                        <!-- DLC Filter -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="DLC:" Foreground="#C2A88B" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="CmbDlcFilter"
                                      Width="148"
                                      Height="30"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbDlcFilter_SelectionChanged"
                                      FontSize="12">
                                <ComboBoxItem x:Name="CbiDlcAll" Content="All Packs (1-641)"/>
                                <ComboBoxItem Content="Rebirth (1-178)"/>
                                <ComboBoxItem Content="Afterbirth (179-276)"/>
                                <ComboBoxItem Content="Afterbirth+ (277-403)"/>
                                <ComboBoxItem Content="Repentance (404-637)"/>
                                <ComboBoxItem Content="Repentance+ (638-641)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Category Filter -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="LblCategoryFilter" Text="Category:" Foreground="#C2A88B" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="CmbCategoryFilter"
                                      Width="148"
                                      Height="30"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbCategoryFilter_SelectionChanged"
                                      FontSize="12">
                                <ComboBoxItem x:Name="CbiCatAll" Content="All Categories"/>
                                <ComboBoxItem x:Name="CbiCatChar" Content="Character"/>
                                <ComboBoxItem x:Name="CbiCatItem" Content="Item"/>
                                <ComboBoxItem x:Name="CbiCatTrinket" Content="Trinket"/>
                                <ComboBoxItem x:Name="CbiCatBoss" Content="Boss &amp; Chapter"/>
                                <ComboBoxItem x:Name="CbiCatChallenge" Content="Challenge"/>
                                <ComboBoxItem x:Name="CbiCatCard" Content="Card / Rune / Soul"/>
                                <ComboBoxItem x:Name="CbiCatBaby" Content="Co-op Baby"/>
                                <ComboBoxItem x:Name="CbiCatRepPlus" Content="Repentance+ &amp; Online"/>
                                <ComboBoxItem x:Name="CbiCatSecret" Content="Secret &amp; Misc"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Right Summary -->
                        <TextBlock x:Name="TxtFilterResultCount"
                                   Grid.Column="4"
                                   Text="Showing 641 achievements"
                                   Foreground="#D4BA98"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ==================== ROW 4: MAIN SPLIT VIEW (ACHIEVEMENT LIST + SECRET PARCHMENT SHEET) ==================== -->
                <Grid Grid.Row="4" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Virtualized List of Achievements -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Isaac "SECRET FOUND!" Pinned Parchment Detail Panel -->
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Virtualized Achievement Cards ListBox -->
                    <Border Grid.Column="0"
                            Background="#120D0B"
                            BorderBrush="#3E2C22"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Margin="0,0,12,0"
                            Padding="4">
                        <ListBox x:Name="LstAchievements"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 SelectionChanged="LstAchievements_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="3,3,6,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemOuter"
                                                        CornerRadius="6"
                                                        BorderThickness="1.5"
                                                        BorderBrush="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemOuter" Property="BorderBrush" Value="#F0C05A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CardBackgroundBrush}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="10,7"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Achievement Icon + Lock Icon Overlay -->
                                                <ColumnDefinition Width="64"/>
                                                <!-- Achievement Title & Unlock Guide -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Status & DLC Badges -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- COL 0: GAME ACHIEVEMENT ICON + LOCK OVERLAY -->
                                            <Border Grid.Column="0"
                                                    Width="54" Height="54"
                                                    Background="#0D0908"
                                                    BorderBrush="#594032"
                                                    BorderThickness="1.5"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding IconSource}"
                                                           Stretch="UniformToFill"
                                                           Opacity="{Binding ImageOpacity}"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                                    <!-- LOCK ICON OVERLAY ON TOP OF LOCKED ACHIEVEMENT IMAGE -->
                                                    <Grid Visibility="{Binding LockOverlayVisibility}"
                                                          Background="#55000000">
                                                        <Border Width="26" Height="26"
                                                                Background="#D91A110E"
                                                                BorderBrush="#D49B4B"
                                                                BorderThickness="1.5"
                                                                CornerRadius="13"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <Canvas Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="M 5.5,8 L 5.5,5.5 C 5.5,3 12.5,3 12.5,5.5 L 12.5,8"
                                                                      Stroke="#F0C775"
                                                                      StrokeThickness="2"
                                                                      Fill="Transparent"/>
                                                                <Rectangle Canvas.Left="3.5" Canvas.Top="7.5"
                                                                           Width="11" Height="8.5"
                                                                           RadiusX="2" RadiusY="2"
                                                                           Fill="#D99B3C"
                                                                           Stroke="#3B2314"
                                                                           StrokeThickness="1"/>
                                                            </Canvas>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Small Checkmark Corner Badge for Unlocked Achievements -->
                                                    <Border Visibility="{Binding UnlockedBadgeVisibility}"
                                                            Background="#D9285E24"
                                                            BorderBrush="#7CE075"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="3,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="2">
                                                        <TextBlock Text="✓" Foreground="#E6FFE3" FontSize="9.5" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- COL 1: CLEAN 2-LINE TITLE & HOW TO UNLOCK -->
                                            <StackPanel Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding DisplayId}"
                                                               Foreground="#E8B454"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontWeight="Bold"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#FAF0DF"
                                                               FontWeight="Bold"
                                                               FontSize="14"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- How to Unlock -->
                                                <TextBlock Text="{Binding DisplayUnlockBy}"
                                                           Foreground="#C9B293"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           HorizontalAlignment="Left"/>
                                            </StackPanel>

                                            <!-- COL 2: COMPACT DLC + STATUS PILLS -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border Background="{Binding DlcBadgeBrush}"
                                                        CornerRadius="3"
                                                        Padding="7,3"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Dlc}"
                                                               Foreground="#F5E8D3"
                                                               FontSize="10.5"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                                <Border Background="{Binding StatusBadgeBrush}"
                                                        CornerRadius="3"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="#FFF5E6"
                                                               FontWeight="Bold"
                                                               FontSize="10.5"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- RIGHT: ISAAC "SECRET FOUND!" PARCHMENT PAPER DETAIL SHEET (CLEAN, NO INNER SCROLLBAR) -->
                    <Border Grid.Column="1"
                            Background="#241914"
                            BorderBrush="#573C2E"
                            BorderThickness="2"
                            CornerRadius="6"
                            Padding="12">
                        <Border Background="#DECDB2"
                                BorderBrush="#8C6D46"
                                BorderThickness="3"
                                CornerRadius="4"
                                Padding="16,12">
                            <StackPanel x:Name="DetailPanelContent">
                                <!-- Top Iron Pin Decoration -->
                                <Ellipse Width="11" Height="11"
                                         Fill="#4A352A"
                                         Stroke="#1F1510"
                                         StrokeThickness="2"
                                         HorizontalAlignment="Center"
                                         Margin="0,0,0,8"/>

                                <!-- Secret Paper Header -->
                                <Border Background="#2B1D16"
                                        CornerRadius="3"
                                        Padding="8,5"
                                        Margin="0,0,0,12">
                                    <TextBlock x:Name="TxtDetailBanner"
                                               Text="SECRET FOUND!"
                                               Foreground="#F5E4C8"
                                               FontWeight="Bold"
                                               FontSize="12.5"
                                               TextAlignment="Center"/>
                                </Border>

                                <!-- 112x112 Polaroid Picture Frame with Lock Overlay when Locked -->
                                <Border Width="112" Height="112"
                                        Background="#140E0C"
                                        BorderBrush="#3D291E"
                                        BorderThickness="4"
                                        CornerRadius="4"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,12">
                                    <Grid>
                                        <Image x:Name="ImgDetailIcon"
                                               Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                        <Grid x:Name="DetailLockOverlay"
                                              Background="#5E000000"
                                              Visibility="Collapsed">
                                            <Border Width="48" Height="48"
                                                    Background="#E51A110E"
                                                    BorderBrush="#E0AD56"
                                                    BorderThickness="2"
                                                    CornerRadius="24"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Canvas Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Data="M 9.5,14 L 9.5,9.5 C 9.5,4.2 22.5,4.2 22.5,9.5 L 22.5,14"
                                                          Stroke="#F5CE7E"
                                                          StrokeThickness="3"
                                                          Fill="Transparent"/>
                                                    <Rectangle Canvas.Left="6.5" Canvas.Top="13.5"
                                                               Width="19" Height="14"
                                                               RadiusX="3" RadiusY="3"
                                                               Fill="#D99B3C"
                                                               Stroke="#3B2314"
                                                               StrokeThickness="1.5"/>
                                                </Canvas>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Achievement #ID and Title -->
                                <TextBlock x:Name="TxtDetailIdAndName"
                                           Text="#001 — Magdalene"
                                           Foreground="#24160E"
                                           FontWeight="Bold"
                                           FontSize="17"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>

                                <!-- Lock / Unlock Status Pill -->
                                <Border x:Name="DetailStatusBorder"
                                        Background="#3A7634"
                                        CornerRadius="4"
                                        Padding="12,4"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,14">
                                    <TextBlock x:Name="TxtDetailStatus"
                                               Text="UNLOCKED IN THIS SAVE FILE"
                                               Foreground="#FFF8EB"
                                               FontWeight="Bold"
                                               FontSize="11"/>
                                </Border>

                                <!-- Metadata Tags (DLC & Category) -->
                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Border Background="#CEBA9A" BorderBrush="#967A56" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LblDetailDlc" Text="DLC PACK" Foreground="#5C442C" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtDetailDlc" Text="Rebirth" Foreground="#24160E" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#CEBA9A" BorderBrush="#967A56" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="LblDetailCategory" Text="CATEGORY" Foreground="#5C442C" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtDetailCategory" Text="Character" Foreground="#24160E" FontSize="13" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <!-- Section 1: Achievement Description -->
                                <Border Background="#CEBA9A"
                                        BorderBrush="#967A56"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="LblDetailDescSection"
                                                   Text="📜 ACHIEVEMENT DESCRIPTION"
                                                   Foreground="#692418"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtDetailDescPrimary"
                                                   Text="-"
                                                   Foreground="#1F130C"
                                                   FontWeight="SemiBold"
                                                   FontSize="12.5"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="TxtDetailDescSecondary" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: How to Unlock -->
                                <Border Background="#CEBA9A"
                                        BorderBrush="#967A56"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,8">
                                    <StackPanel>
                                        <TextBlock x:Name="LblDetailUnlockPrimary"
                                                   Text="🗝️ HOW TO UNLOCK"
                                                   Foreground="#692418"
                                                   FontWeight="Bold"
                                                   FontSize="11"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtDetailUnlockPrimary"
                                                   Text="-"
                                                   Foreground="#1C100A"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="LblDetailUnlockSecondary" Visibility="Collapsed"/>
                                        <TextBlock x:Name="TxtDetailUnlockSecondary" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>

                <!-- ==================== ROW 5: FOOTER BAR ==================== -->
                <Border Grid.Row="5"
                        Background="#0E0A08"
                        BorderBrush="#38251D"
                        BorderThickness="0,1,0,0"
                        Padding="14,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFooterStatus"
                                   Text="Ready • Save file loaded in Read-Only mode."
                                   Foreground="#A89076"
                                   FontSize="11"/>
                        <TextBlock x:Name="TxtFooterRight"
                                   Text="The Binding of Isaac: Repentance+ Achievement Viewer (.NET WPF • Read-Only)"
                                   Foreground="#78634F"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>

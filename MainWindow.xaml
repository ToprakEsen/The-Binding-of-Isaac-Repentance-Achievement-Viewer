<Window x:Class="IsaacRepentancePlusAchievements.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="The Binding of Isaac: Repentance+ - Başarım Günlüğü"
        Width="1380" Height="860"
        MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Title Bar Control Button Style -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#241915"/>
            <Setter Property="Foreground" Value="#EAD8BF"/>
            <Setter Property="BorderBrush" Value="#4D362B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D2A22"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#C49746"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A110E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style (Blood Red Hover) -->
        <Style x:Key="CloseBarButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Background" Value="#4A1717"/>
            <Setter Property="BorderBrush" Value="#7D2828"/>
            <Setter Property="Foreground" Value="#F5E6D3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="12,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#9E1F1F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E34B4B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#631212"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Filter Tab Button Style -->
        <Style x:Key="IsaacFilterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#251B16"/>
            <Setter Property="Foreground" Value="#DECBB0"/>
            <Setter Property="BorderBrush" Value="#4E382C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3B2A21"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#C49746"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Save Slot Button Style -->
        <Style x:Key="SaveSlotButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="slotBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="5"
                                Padding="11,7">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="slotBorder" Property="BorderBrush" Value="#E0B25B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Basement Frame -->
    <Border x:Name="OuterWindowBorder"
            Background="#140F0D"
            BorderBrush="#593A2B"
            BorderThickness="2">
        <Border BorderBrush="#261813" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Row 0: Custom Isaac Title Bar -->
                    <RowDefinition Height="48"/>
                    <!-- Row 1: Save Slots & Live Read-Only Save Stats Banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 2: Search & Filter Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row 3: Achievements List + Secret Found Parchment Panel -->
                    <RowDefinition Height="*"/>
                    <!-- Row 4: Footer Status Bar -->
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <!-- ==================== ROW 0: CUSTOM TITLE BAR (KENDİNE ÖZEL AÇMA/KAPAMA BARI) ==================== -->
                <Border Grid.Row="0"
                        Background="#0E0A08"
                        BorderBrush="#4A251D"
                        BorderThickness="0,0,0,2"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid Margin="12,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Isaac Emblem & App Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="32" Height="32" Background="#2B1612" BorderBrush="#8C2D22" BorderThickness="1.5" CornerRadius="16" Margin="0,0,10,0">
                                <Canvas Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Canvas.Left="4" Canvas.Top="4" Width="20" Height="20" Fill="#E3C7A6" Stroke="#382218" StrokeThickness="1.5"/>
                                    <Rectangle Canvas.Left="8" Canvas.Top="13" Width="3" Height="8" Fill="#4EA8DE"/>
                                    <Rectangle Canvas.Left="17" Canvas.Top="13" Width="3" Height="8" Fill="#4EA8DE"/>
                                    <Ellipse Canvas.Left="7.5" Canvas.Top="10" Width="4" Height="4" Fill="#1E120E"/>
                                    <Ellipse Canvas.Left="16.5" Canvas.Top="10" Width="4" Height="4" Fill="#1E120E"/>
                                    <Path Data="M 10,19 Q 14,16 18,19" Stroke="#382218" StrokeThickness="1.5"/>
                                </Canvas>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="THE BINDING OF ISAAC: REPENTANCE+"
                                               Foreground="#F2E2C9"
                                               FontSize="13.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <Border Background="#7A1C1C" BorderBrush="#B83737" BorderThickness="1" CornerRadius="3" Padding="7,1" Margin="8,0,0,0">
                                        <TextBlock Text="BAŞARIM GÜNLÜĞÜ" Foreground="#FFF0DB" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Otomatik Save Okuyucu • 641 Resmi Başarım • Türkçe ve İngilizce Açıklamalar"
                                           Foreground="#A89076"
                                           FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Center: Read-Only Security Shield Indicator -->
                        <Border Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#172416"
                                BorderBrush="#3E6B3A"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 6,1 L 1,3.5 L 1,7.5 C 1,11 3.2,13.8 6,15 C 8.8,13.8 11,11 11,7.5 L 11,3.5 Z"
                                      Fill="#6CC464"
                                      VerticalAlignment="Center"
                                      Margin="0,0,7,0"/>
                                <TextBlock Text="SALT OKUNUR (READ-ONLY) MOD AKTİF — SAVE DOSYASI DÜZENLENEMEZ"
                                           Foreground="#B4E8AE"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Action Buttons & Custom Minimize / Maximize / Close Bar -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnRefreshSave"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="BtnRefreshSave_Click"
                                    Margin="0,0,6,0"
                                    ToolTip="Kayıt dosyasını yeniden oku (Salt Okunur)">
                                <TextBlock Text="↻ Yenile" FontSize="11.5"/>
                            </Button>

                            <Button x:Name="BtnSelectSaveFile"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Click="BtnSelectSaveFile_Click"
                                    Margin="0,0,14,0"
                                    ToolTip="Farklı bir .dat kayıt dosyası seç (Sadece okunur, değiştirilemez)">
                                <TextBlock Text="📂 Save Seç" FontSize="11.5"/>
                            </Button>

                            <!-- Minimize -->
                            <Button x:Name="BtnMinimize"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Width="34" Height="28"
                                    Margin="0,0,4,0"
                                    Click="BtnMinimize_Click"
                                    ToolTip="Küçült">
                                <TextBlock Text="—" FontWeight="Bold"/>
                            </Button>

                            <!-- Maximize / Restore -->
                            <Button x:Name="BtnMaximize"
                                    Style="{StaticResource TitleBarButtonStyle}"
                                    Width="34" Height="28"
                                    Margin="0,0,4,0"
                                    Click="BtnMaximize_Click"
                                    ToolTip="Tam Ekran / Boyutu Geri Yükle">
                                <TextBlock x:Name="TxtMaximizeIcon" Text="▢" FontWeight="Bold"/>
                            </Button>

                            <!-- Close -->
                            <Button x:Name="BtnClose"
                                    Style="{StaticResource CloseBarButtonStyle}"
                                    Width="38" Height="28"
                                    Click="BtnClose_Click"
                                    ToolTip="Uygulamayı Kapat">
                                <TextBlock Text="✕" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== ROW 1: SAVE SLOTS & BASEMENT STATS BANNER ==================== -->
                <Border Grid.Row="1"
                        Background="#1A1310"
                        BorderBrush="#3D2B22"
                        BorderThickness="0,0,0,1"
                        Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- 3 Save File Slots -->
                            <ColumnDefinition Width="480"/>
                            <!-- Overall Progress & Save Path Info -->
                            <ColumnDefinition Width="*"/>
                            <!-- Live Save Counters -->
                            <ColumnDefinition Width="430"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Save File 1 / 2 / 3 Selector Cards -->
                        <UniformGrid Grid.Column="0" Columns="3" Margin="0,0,12,0">
                            <!-- SLOT 1 -->
                            <Button x:Name="BtnSlot1" Style="{StaticResource SaveSlotButtonStyle}" Margin="0,0,6,0" Click="BtnSlot1_Click" Background="#2E211B" BorderBrush="#C49746">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="1. KAYIT" Foreground="#F2DFC4" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtSlot1Percent" Text="%0" Foreground="#F0C265" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtSlot1Count" Text="0 / 641 Sır" Foreground="#DFC9AA" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,2"/>
                                    <TextBlock x:Name="TxtSlot1Rank" Text="Yükleniyor..." Foreground="#A68C72" FontSize="10.5"/>
                                </StackPanel>
                            </Button>

                            <!-- SLOT 2 -->
                            <Button x:Name="BtnSlot2" Style="{StaticResource SaveSlotButtonStyle}" Margin="3,0,3,0" Click="BtnSlot2_Click" Background="#1E1612" BorderBrush="#4A3429">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="2. KAYIT" Foreground="#F2DFC4" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtSlot2Percent" Text="%0" Foreground="#F0C265" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtSlot2Count" Text="0 / 641 Sır" Foreground="#DFC9AA" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,2"/>
                                    <TextBlock x:Name="TxtSlot2Rank" Text="Yükleniyor..." Foreground="#A68C72" FontSize="10.5"/>
                                </StackPanel>
                            </Button>

                            <!-- SLOT 3 -->
                            <Button x:Name="BtnSlot3" Style="{StaticResource SaveSlotButtonStyle}" Margin="6,0,0,0" Click="BtnSlot3_Click" Background="#1E1612" BorderBrush="#4A3429">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="3. KAYIT" Foreground="#F2DFC4" FontWeight="Bold" FontSize="11.5"/>
                                        <TextBlock Grid.Column="1" x:Name="TxtSlot3Percent" Text="%0" Foreground="#F0C265" FontFamily="Consolas, Segoe UI" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                    <TextBlock x:Name="TxtSlot3Count" Text="0 / 641 Sır" Foreground="#DFC9AA" FontSize="13" FontWeight="SemiBold" Margin="0,3,0,2"/>
                                    <TextBlock x:Name="TxtSlot3Rank" Text="Yükleniyor..." Foreground="#A68C72" FontSize="10.5"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>

                        <!-- Center: Progress Bar & Auto-Detected Save Path -->
                        <Border Grid.Column="1"
                                Background="#231915"
                                BorderBrush="#473227"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="12,8"
                                Margin="0,0,12,0">
                            <StackPanel VerticalAlignment="Center">
                                <Grid Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtActiveSlotHeader"
                                               Grid.Column="0"
                                               Text="AKTİF KAYIT: 1. DOSYA"
                                               Foreground="#F2E0C4"
                                               FontWeight="Bold"
                                               FontSize="11.5"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,8,0"/>
                                    <TextBlock x:Name="TxtProgressSummary"
                                               Grid.Column="1"
                                               Text="228 Açık / 413 Kilitli (%35.6)"
                                               Foreground="#F0C265"
                                               FontWeight="Bold"
                                               FontSize="11.5"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <!-- Custom Isaac Progress Bar -->
                                <Grid Height="15" Margin="0,0,0,6">
                                    <Border Background="#120C0A" BorderBrush="#4F372B" BorderThickness="1" CornerRadius="3"/>
                                    <Border x:Name="ProgressFillBorder"
                                            HorizontalAlignment="Left"
                                            Width="120"
                                            Margin="1"
                                            CornerRadius="2">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#7D1919" Offset="0.0"/>
                                                <GradientStop Color="#B83228" Offset="0.6"/>
                                                <GradientStop Color="#D99B38" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                </Grid>

                                <TextBlock x:Name="TxtSaveFilePath"
                                           Text="Save Yolu: Otomatik aranıyor..."
                                           Foreground="#A89076"
                                           FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Right: Live In-Game Counters from Save File -->
                        <Border Grid.Column="2"
                                Background="#231915"
                                BorderBrush="#473227"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="10,6">
                            <UniformGrid Rows="2" Columns="3">
                                <StackPanel Margin="4,1">
                                    <TextBlock Text="MOM KILLS" Foreground="#9C8268" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatMomKills" Text="0" Foreground="#F5E4CA" FontFamily="Consolas, Segoe UI" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4,1">
                                    <TextBlock Text="ÖLÜM (DEATHS)" Foreground="#9C8268" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatDeaths" Text="0" Foreground="#EB7A7A" FontFamily="Consolas, Segoe UI" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4,1">
                                    <TextBlock Text="SERİ (EN İYİ)" Foreground="#9C8268" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatStreak" Text="0 (0)" Foreground="#92DE87" FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4,1">
                                    <TextBlock Text="BAĞIŞ / GREED" Foreground="#9C8268" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatDonation" Text="0¢ / 0¢" Foreground="#F0C869" FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4,1">
                                    <TextBlock Text="EDEN TOKEN" Foreground="#9C8268" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatEden" Text="0" Foreground="#C4A6F0" FontFamily="Consolas, Segoe UI" FontSize="13.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="4,1">
                                    <TextBlock Text="EŞYA / CHALLENGE" Foreground="#9C8268" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtStatItemsChallenges" Text="0 / 0" Foreground="#86CCE0" FontFamily="Consolas, Segoe UI" FontSize="13" FontWeight="Bold"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==================== ROW 2: SEARCH & FILTER CONTROL BAR ==================== -->
                <Border Grid.Row="2"
                        Background="#1E1612"
                        BorderBrush="#3D2B22"
                        BorderThickness="0,0,0,1"
                        Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Search Box -->
                            <ColumnDefinition Width="300"/>
                            <!-- Unlock Status Filter Buttons -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- DLC Filter ComboBox -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Category Filter ComboBox -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Filtered Results Count -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Search Box -->
                        <Border Grid.Column="0"
                                Background="#120D0B"
                                BorderBrush="#543B2E"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,0,12,0"
                                Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" Foreground="#9C826B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtSearchPlaceholder"
                                           Grid.Column="1"
                                           Text="Başarım adı, #ID (örn: 641) veya açıklama ara..."
                                           Foreground="#786250"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="TxtSearch"
                                         Grid.Column="1"
                                         Background="Transparent"
                                         Foreground="#F5E5CC"
                                         CaretBrush="#E5B95C"
                                         BorderThickness="0"
                                         FontSize="12.5"
                                         VerticalAlignment="Center"
                                         TextChanged="TxtSearch_TextChanged"/>
                            </Grid>
                        </Border>

                        <!-- Status Filter Buttons (All / Unlocked / Locked) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                            <Button x:Name="BtnFilterAll"
                                    Content="Tümü (641)"
                                    Style="{StaticResource IsaacFilterButtonStyle}"
                                    Click="BtnFilterAll_Click"/>
                            <Button x:Name="BtnFilterUnlocked"
                                    Content="✓ Açılanlar (0)"
                                    Style="{StaticResource IsaacFilterButtonStyle}"
                                    Click="BtnFilterUnlocked_Click"/>
                            <Button x:Name="BtnFilterLocked"
                                    Content="🔒 Kilitliler (0)"
                                    Style="{StaticResource IsaacFilterButtonStyle}"
                                    Click="BtnFilterLocked_Click"/>
                        </StackPanel>

                        <!-- DLC Filter -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="DLC:" Foreground="#C2A88B" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbDlcFilter"
                                      Width="175"
                                      Height="30"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbDlcFilter_SelectionChanged"
                                      FontSize="12">
                                <ComboBoxItem Content="Tüm Paketler (1-641)"/>
                                <ComboBoxItem Content="Rebirth (1-178)"/>
                                <ComboBoxItem Content="Afterbirth (179-276)"/>
                                <ComboBoxItem Content="Afterbirth+ (277-403)"/>
                                <ComboBoxItem Content="Repentance (404-637)"/>
                                <ComboBoxItem Content="Repentance+ (638-641)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Category Filter -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Kategori:" Foreground="#C2A88B" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbCategoryFilter"
                                      Width="175"
                                      Height="30"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbCategoryFilter_SelectionChanged"
                                      FontSize="12">
                                <ComboBoxItem Content="Tüm Kategoriler"/>
                                <ComboBoxItem Content="Karakter"/>
                                <ComboBoxItem Content="Eşya (Item)"/>
                                <ComboBoxItem Content="Trinket"/>
                                <ComboBoxItem Content="Boss &amp; Bölüm"/>
                                <ComboBoxItem Content="Challenge"/>
                                <ComboBoxItem Content="Kart / Rune / Soul"/>
                                <ComboBoxItem Content="Co-op Baby"/>
                                <ComboBoxItem Content="Repentance+ &amp; Online"/>
                                <ComboBoxItem Content="Sır &amp; Genel"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Right Summary -->
                        <TextBlock x:Name="TxtFilterResultCount"
                                   Grid.Column="4"
                                   Text="641 başarım listeleniyor"
                                   Foreground="#D4BA98"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ==================== ROW 3: MAIN SPLIT VIEW (ACHIEVEMENT LIST + SECRET PARCHMENT SHEET) ==================== -->
                <Grid Grid.Row="3" Margin="12,10,12,8">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Virtualized List of Achievements -->
                        <ColumnDefinition Width="*"/>
                        <!-- Right: Isaac "SECRET FOUND!" Pinned Parchment Detail Panel -->
                        <ColumnDefinition Width="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Virtualized Achievement Cards ListBox -->
                    <Border Grid.Column="0"
                            Background="#120D0B"
                            BorderBrush="#3E2C22"
                            BorderThickness="1.5"
                            CornerRadius="6"
                            Margin="0,0,12,0"
                            Padding="4">
                        <ListBox x:Name="LstAchievements"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 VirtualizingStackPanel.ScrollUnit="Pixel"
                                 SelectionChanged="LstAchievements_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="3,3,6,3"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemOuter"
                                                        CornerRadius="6"
                                                        BorderThickness="1.5"
                                                        BorderBrush="Transparent">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemOuter" Property="BorderBrush" Value="#F0C05A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding CardBackgroundBrush}"
                                            BorderBrush="{Binding CardBorderBrush}"
                                            BorderThickness="1.5"
                                            CornerRadius="5"
                                            Padding="10,8"
                                            Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- Achievement Icon + Lock Icon Overlay -->
                                                <ColumnDefinition Width="72"/>
                                                <!-- Achievement Texts & Descriptions -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Status & DLC Badges -->
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- COL 0: GAME ACHIEVEMENT ICON + LOCK OVERLAY -->
                                            <Border Grid.Column="0"
                                                    Width="64" Height="64"
                                                    Background="#0D0908"
                                                    BorderBrush="#594032"
                                                    BorderThickness="2"
                                                    CornerRadius="4"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <!-- Official Game Achievement Image -->
                                                    <Image Source="{Binding IconSource}"
                                                           Stretch="UniformToFill"
                                                           Opacity="{Binding ImageOpacity}"
                                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                                    <!-- LOCK ICON OVERLAY ON TOP OF LOCKED ACHIEVEMENT IMAGE -->
                                                    <Grid Visibility="{Binding LockOverlayVisibility}"
                                                          Background="#55000000">
                                                        <Line X1="0" Y1="0" X2="60" Y2="60" Stroke="#88261B16" StrokeThickness="2" StrokeDashArray="2,1"/>
                                                        <Line X1="60" Y1="0" X2="0" Y2="60" Stroke="#88261B16" StrokeThickness="2" StrokeDashArray="2,1"/>

                                                        <!-- Central Iron/Gold Padlock Badge -->
                                                        <Border Width="30" Height="30"
                                                                Background="#D91A110E"
                                                                BorderBrush="#D49B4B"
                                                                BorderThickness="1.5"
                                                                CornerRadius="15"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center">
                                                            <Canvas Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <Path Data="M 6,9 L 6,6 C 6,3.2 14,3.2 14,6 L 14,9"
                                                                      Stroke="#F0C775"
                                                                      StrokeThickness="2.2"
                                                                      Fill="Transparent"/>
                                                                <Rectangle Canvas.Left="4" Canvas.Top="8.5"
                                                                           Width="12" Height="9.5"
                                                                           RadiusX="2" RadiusY="2"
                                                                           Fill="#D99B3C"
                                                                           Stroke="#3B2314"
                                                                           StrokeThickness="1"/>
                                                                <Ellipse Canvas.Left="8.6" Canvas.Top="11" Width="2.8" Height="2.8" Fill="#1F120B"/>
                                                                <Rectangle Canvas.Left="9.3" Canvas.Top="13" Width="1.4" Height="3" Fill="#1F120B"/>
                                                            </Canvas>
                                                        </Border>
                                                    </Grid>

                                                    <!-- Small Checkmark Corner Badge for Unlocked Achievements -->
                                                    <Border Visibility="{Binding UnlockedBadgeVisibility}"
                                                            Background="#D9285E24"
                                                            BorderBrush="#7CE075"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="3,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Bottom"
                                                            Margin="2">
                                                        <TextBlock Text="✓" Foreground="#E6FFE3" FontSize="10" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- COL 1: TITLE & DESCRIPTIONS -->
                                            <StackPanel Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding DisplayId}"
                                                               Foreground="#E8B454"
                                                               FontFamily="Consolas, Segoe UI"
                                                               FontWeight="Bold"
                                                               FontSize="13.5"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#FAF0DF"
                                                               FontWeight="Bold"
                                                               FontSize="14.5"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <!-- Oyun İçi Açıklama -->
                                                <TextBlock Text="{Binding InGameDescTr}"
                                                           Foreground="#C9B293"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           HorizontalAlignment="Left"
                                                           Margin="0,0,0,3"/>

                                                <!-- Nasıl Açılır (Unlock Condition) -->
                                                <TextBlock TextWrapping="Wrap" HorizontalAlignment="Left" FontSize="12"><Run Text="Nasıl Açılır: " Foreground="#EA9B56" FontWeight="SemiBold"/><Run Text="{Binding UnlockByTr}" Foreground="#EFE1CA"/></TextBlock>
                                            </StackPanel>

                                            <!-- COL 2: STATUS & DLC BADGES -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <Border Background="{Binding StatusBadgeBrush}"
                                                        CornerRadius="3"
                                                        Padding="8,3"
                                                        Margin="0,0,0,5"
                                                        HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="#FFF5E6"
                                                               FontWeight="Bold"
                                                               FontSize="10.5"/>
                                                </Border>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Background="{Binding DlcBadgeBrush}"
                                                            CornerRadius="3"
                                                            Padding="6,2"
                                                            Margin="0,0,4,0">
                                                        <TextBlock Text="{Binding Dlc}"
                                                                   Foreground="#F5E8D3"
                                                                   FontSize="10.5"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                    <Border Background="#2E221C"
                                                            BorderBrush="#543E33"
                                                            BorderThickness="1"
                                                            CornerRadius="3"
                                                            Padding="6,2">
                                                        <TextBlock Text="{Binding Category}"
                                                                   Foreground="#D9C3A5"
                                                                   FontSize="10.5"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- RIGHT: ISAAC "SECRET FOUND!" PARCHMENT PAPER DETAIL SHEET -->
                    <Border Grid.Column="1"
                            Background="#241914"
                            BorderBrush="#573C2E"
                            BorderThickness="2"
                            CornerRadius="6"
                            Padding="12">
                        <Grid>
                            <!-- Aged Parchment Paper Note -->
                            <Border Background="#DECDB2"
                                    BorderBrush="#8C6D46"
                                    BorderThickness="3"
                                    CornerRadius="4"
                                    Padding="14,10">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="DetailPanelContent">
                                        <!-- Top Iron Pin Decoration -->
                                        <Ellipse Width="12" Height="12"
                                                 Fill="#4A352A"
                                                 Stroke="#1F1510"
                                                 StrokeThickness="2"
                                                 HorizontalAlignment="Center"
                                                 Margin="0,0,0,6"/>

                                        <!-- Secret Paper Header -->
                                        <Border Background="#2B1D16"
                                                CornerRadius="3"
                                                Padding="8,5"
                                                Margin="0,0,0,10">
                                            <TextBlock x:Name="TxtDetailBanner"
                                                       Text="SECRET FOUND! (SIR KAĞIDI)"
                                                       Foreground="#F5E4C8"
                                                       FontWeight="Bold"
                                                       FontSize="12.5"
                                                       TextAlignment="Center"/>
                                        </Border>

                                        <!-- Large 124x124 Polaroid Picture Frame with Lock Overlay when Locked -->
                                        <Border Width="124" Height="124"
                                                Background="#140E0C"
                                                BorderBrush="#3D291E"
                                                BorderThickness="4"
                                                CornerRadius="4"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,10">
                                            <Grid>
                                                <Image x:Name="ImgDetailIcon"
                                                       Stretch="UniformToFill"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                                                <!-- Large Lock Icon Overlay when selected achievement is LOCKED -->
                                                <Grid x:Name="DetailLockOverlay"
                                                      Background="#5E000000"
                                                      Visibility="Collapsed">
                                                    <Line X1="0" Y1="0" X2="132" Y2="132" Stroke="#992B1D16" StrokeThickness="3" StrokeDashArray="3,2"/>
                                                    <Line X1="132" Y1="0" X2="0" Y2="132" Stroke="#992B1D16" StrokeThickness="3" StrokeDashArray="3,2"/>

                                                    <Border Width="54" Height="54"
                                                            Background="#E51A110E"
                                                            BorderBrush="#E0AD56"
                                                            BorderThickness="2"
                                                            CornerRadius="27"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                        <Canvas Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <Path Data="M 10,15 L 10,10 C 10,4.5 24,4.5 24,10 L 24,15"
                                                                  Stroke="#F5CE7E"
                                                                  StrokeThickness="3.2"
                                                                  Fill="Transparent"/>
                                                            <Rectangle Canvas.Left="7" Canvas.Top="14.5"
                                                                       Width="20" Height="15"
                                                                       RadiusX="3" RadiusY="3"
                                                                       Fill="#D99B3C"
                                                                       Stroke="#3B2314"
                                                                       StrokeThickness="1.5"/>
                                                            <Ellipse Canvas.Left="14.5" Canvas.Top="18.5" Width="5" Height="5" Fill="#1F120B"/>
                                                            <Rectangle Canvas.Left="15.8" Canvas.Top="22" Width="2.4" Height="5" Fill="#1F120B"/>
                                                        </Canvas>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- Achievement #ID and Title -->
                                        <TextBlock x:Name="TxtDetailIdAndName"
                                                   Text="#001 — Magdalene"
                                                   Foreground="#24160E"
                                                   FontWeight="Bold"
                                                   FontSize="17.5"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,8"/>

                                        <!-- Lock / Unlock Status Pill -->
                                        <Border x:Name="DetailStatusBorder"
                                                Background="#3A7634"
                                                CornerRadius="4"
                                                Padding="12,4"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,12">
                                            <TextBlock x:Name="TxtDetailStatus"
                                                       Text="BU BAŞARIM AÇILMIŞ"
                                                       Foreground="#FFF8EB"
                                                       FontWeight="Bold"
                                                       FontSize="11"/>
                                        </Border>

                                        <!-- Metadata Tags (DLC & Category) -->
                                        <UniformGrid Columns="2" Margin="0,0,0,12">
                                            <Border Background="#CEBA9A" BorderBrush="#967A56" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="0,0,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="PAKET (DLC)" Foreground="#5C442C" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock x:Name="TxtDetailDlc" Text="Rebirth" Foreground="#24160E" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#CEBA9A" BorderBrush="#967A56" BorderThickness="1" CornerRadius="3" Padding="8,5" Margin="4,0,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="KATEGORİ" Foreground="#5C442C" FontSize="10" FontWeight="Bold"/>
                                                    <TextBlock x:Name="TxtDetailCategory" Text="Karakter" Foreground="#24160E" FontSize="13" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <!-- Section 1: Oyun İçi Açıklama (TR & EN) -->
                                        <Border Background="#CEBA9A"
                                                BorderBrush="#967A56"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,8"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="📜 BAŞARIM HAKKINDA AÇIKLAMA"
                                                           Foreground="#692418"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TxtDetailDescTr"
                                                           Text="-"
                                                           Foreground="#1F130C"
                                                           FontWeight="SemiBold"
                                                           FontSize="12.5"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TxtDetailDescEn"
                                                           Text="-"
                                                           Foreground="#4F3A28"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Section 2: Nasıl Açılır (Unlock Condition TR) -->
                                        <Border Background="#CEBA9A"
                                                BorderBrush="#967A56"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,8"
                                                Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🗝️ NASIL AÇILIR? (TÜRKÇE REHBER)"
                                                           Foreground="#692418"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock x:Name="TxtDetailUnlockTr"
                                                           Text="-"
                                                           Foreground="#1C100A"
                                                           FontWeight="SemiBold"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Section 3: Original English Requirement -->
                                        <Border Background="#CEBA9A"
                                                BorderBrush="#967A56"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,8">
                                            <StackPanel>
                                                <TextBlock Text="🌐 ORİJİNAL KOŞUL (ENGLISH)"
                                                           Foreground="#5C442C"
                                                           FontWeight="Bold"
                                                           FontSize="10.5"
                                                           Margin="0,0,0,3"/>
                                                <TextBlock x:Name="TxtDetailUnlockEn"
                                                           Text="-"
                                                           Foreground="#362417"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ==================== ROW 4: FOOTER BAR ==================== -->
                <Border Grid.Row="4"
                        Background="#0E0A08"
                        BorderBrush="#38251D"
                        BorderThickness="0,1,0,0"
                        Padding="14,0">
                    <DockPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFooterStatus"
                                   Text="Hazır • Save dosyası salt okunur (Read-Only) modda yüklendi."
                                   Foreground="#A89076"
                                   FontSize="11"/>
                        <TextBlock Text="The Binding of Isaac: Repentance+ Achievement Viewer (.NET WPF • Salt Okunur)"
                                   Foreground="#78634F"
                                   FontSize="11"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
